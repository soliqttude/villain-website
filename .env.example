# ========================
# Villain Environment
# ========================

# Database
DATABASE_URL="postgresql://user:password@host:5432/villain?schema=public"

# Redis
REDIS_URL="redis://default:password@host:6379"

# Token Encryption (CRITICAL)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="your-64-character-hex-key-here"

# Discord OAuth
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-too"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin
ADMIN_DISCORD_IDS="123456789012345678,987654321098765432"
